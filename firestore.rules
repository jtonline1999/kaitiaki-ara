rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only authenticated users can read or write vehicles they own.
    match /vehicles/{vehicleId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Compliance records can be read or written if the user owns the associated vehicle.
    match /complianceRecords/{recordId} {
      allow read, write: if request.auth != null && get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.userId == request.auth.uid;
    }
  }
}
