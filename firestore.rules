
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // A user can create a vehicle if they are logged in and the userId matches their own.
    match /vehicles/{vehicleId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /complianceRecords/{recordId} {
      // Users can read compliance records if they can read the associated vehicle
      allow read: if request.auth != null && get(/databases/$(database)/documents/vehicles/$(resource.data.vehicleId)).data.userId == request.auth.uid;
      
      // Allow create if the user owns the vehicle they are attaching the record to
      allow create: if request.auth != null && get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.userId == request.auth.uid;

      // Allow update and delete if the user owns the vehicle associated with the existing record
      allow update, delete: if request.auth != null && get(/databases/$(database)/documents/vehicles/$(resource.data.vehicleId)).data.userId == request.auth.uid;
    }
  }
}
