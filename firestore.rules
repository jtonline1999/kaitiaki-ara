rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check ownership
    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Users can only read and write their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Vehicles can be read/written only by the owner.
    match /vehicles/{vehicleId} {
      allow read: if isOwner(resource.data.ownerUid);
      allow create: if isOwner(request.resource.data.ownerUid);
      allow update, delete: if isOwner(resource.data.ownerUid);
    }

    // Compliance records can be read/written only by the owner.
    // Also, ensures the record is for a vehicle owned by the same user.
    match /complianceRecords/{recordId} {
      allow read: if isOwner(resource.data.ownerUid);
      allow create: if isOwner(request.resource.data.ownerUid) &&
                       get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner(resource.data.ownerUid);
    }
  }
}
