rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /vehicles/{vehicleId} {
      // Allow read, update, delete if the user owns the vehicle
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      // Allow create if the user is logged in and the new document's userId matches their own
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    match /complianceRecords/{recordId} {
      // Allow read, update, delete if the user owns the associated vehicle
      allow read, update, delete: if request.auth != null && get(/databases/$(database)/documents/vehicles/$(resource.data.vehicleId)).data.userId == request.auth.uid;
       // Allow create if the user owns the associated vehicle
      allow create: if request.auth != null && get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.userId == request.auth.uid;
    }
  }
}
